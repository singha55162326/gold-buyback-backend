# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kpv_gold?schema=public"

# ---- API ----
API_PORT=4000
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="30m"
JWT_REFRESH_TTL="7d"
CORS_ORIGIN="http://localhost:3000"

# ---- Web ----
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---- WhatsApp notifications via a self-hosted OpenWA gateway ----
# https://www.open-wa.org — UNOFFICIAL WhatsApp gateway, no affiliation with
# Meta. Use it only for transactional alerts to your own opted-in staff.
# Leave WHATSAPP_ENABLED=false to run on Socket.IO alerts alone.
WHATSAPP_ENABLED=false
OPENWA_BASE_URL="http://localhost:2785"
OPENWA_API_KEY=""
OPENWA_SESSION_ID=""
OPENWA_TIMEOUT_MS=10000
# Outbox worker
WHATSAPP_POLL_MS=15000
WHATSAPP_BATCH_SIZE=20
WHATSAPP_MAX_ATTEMPTS=3

# ---- Seed (dev only) ----
SEED_DEFAULT_PASSWORD="Kpv@12345"
