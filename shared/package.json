{
  "name": "@kpv/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Pure calculation engine for the KPV gold store system (pricing, buyback, exchange, stock, AP/AR)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "decimal.js": "^10.5.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
